# .env.example
# Salin ke .env lalu isi nilainya. Jangan commit .env ke git.

# ── vSZ Controller (REST API) ────────────────────────
VSZ_HOST=10.0.0.5
VSZ_PORT=8443
VSZ_USER=admin
VSZ_PASS=''
VSZ_API_TOKEN=              # token-based auth (opsional, kalau tersedia)
VSZ_API_VERSION=v11_1       # vSZ API version: v10_0, v11_1, v12_0, etc.

# ── SSH Credentials ──────────────────────────────────
RUCKUS_ICX_USER=
RUCKUS_ICX_PASS=

# ── MCP Server ────────────────────────────────────────
MCP_TRANSPORT=sse           # sse | streamable-http
MCP_PORT=8000
MCP_HOST=0.0.0.0	    # IP MCP Client
LOG_LEVEL=INFO              # DEBUG, INFO, WARNING, ERROR

# ── Security (optional, HTTP transports only) ─────────
MCP_API_KEY=                # Bearer token untuk auth MCP endpoint
                            #   Client kirim: Authorization: Bearer <nilai ini>
                            #   Kosongkan = tanpa autentikasi

MCP_ALLOWED_IPS=            # Whitelist IP (CIDR), comma-separated
                            #   Contoh: 10.0.0.0/8,192.168.1.0/24
                            #   Kosongkan = semua IP diizinkan

# ── Thresholds (opsional, ada default di kode) ───────
CPU_THRESHOLD=80
MEMORY_THRESHOLD=85
AP_CLIENT_THRESHOLD=50
