# .env.example
# Copy to .env and fill in the values. Do not commit .env to git.

# ── vSZ Controller (REST API) ────────────────────────
VSZ_HOST=192.0.2.5
VSZ_PORT=8443
VSZ_USER=admin
VSZ_PASS=''
VSZ_API_TOKEN=              # token-based auth (optional, if available)
VSZ_API_VERSION=v11_1       # vSZ API version: v10_0, v11_1, v12_0, etc.
VSZ_RATE_LIMIT=10           # max concurrent API requests (default: 10)
ICX_RATE_LIMIT=5            # max concurrent SSH sessions per device (default: 5)

# ── ICX SSH Credentials ────────────────────────────
# Credentials are set in inventory/devices.yaml (username / password fields).
# Can be a literal value or an ${ENV_VAR} reference to .env.
# Example reference:
#   ICX_CORE_USER=admin
#   ICX_CORE_PASS=CHANGE_ME

# ── MCP Server ────────────────────────────────────────
MCP_TRANSPORT=streamable-http  # streamable-http (default) | sse (legacy)
MCP_PORT=8000
MCP_HOST=0.0.0.0            # bind address (0.0.0.0 = all interfaces)
LOG_LEVEL=INFO              # DEBUG, INFO, WARNING, ERROR
MCP_MAX_ITEMS=50            # hard cap on list length returned by list tools

# ── Security (optional, HTTP transports only) ─────────
MCP_API_KEY=                # Fallback single bearer token for the MCP endpoint
                            #   Client sends: Authorization: Bearer <this value>
                            #   Leave empty to use per-client keys (managed in the
                            #   admin GUI) or no auth.

MCP_ALLOWED_IPS=            # Whitelist IP (CIDR), comma-separated
                            #   Example: 192.0.2.0/24,198.51.100.0/24
                            #   Leave empty = all IPs allowed

# Per-client API keys + audit trail are stored in SQLite (data/admin.db)
# and managed via the admin GUI. Tool calls are recorded to the SQLite
# audit_log table.

# ── Storage ────────────────────────────────────────────
MCP_DB_PATH=./data/admin.db  # SQLite DB (users, API keys, audit trail)

# ── Audit retention ─────────────────────────────────────
MCP_AUDIT_RETENTION_DAYS=90  # days to keep audit events (rotation)
                             #   0 = keep forever (rotation disabled)
                             #   default: 90 days

# ── Admin GUI (separate process) ───────────────────────
MCP_ADMIN_HOST=127.0.0.1    # admin bind (127.0.0.1 = localhost only)
MCP_ADMIN_PORT=8001
MCP_ADMIN_USER=admin        # default superadmin username (first boot only)
MCP_ADMIN_INIT_PASS=digantiYA_30  # initial password (first boot only); change it on first login

# Command the admin GUI runs when you click "Restart MCP". Any executable
# string works (it is split like a shell command; no shell is invoked).
#   systemd (Linux):  systemctl restart mcp-ruckus
#   native (all OS):  python run.py restart   (or python3 / absolute venv path)
#   Docker:           docker compose restart mcp-ruckus
MCP_RESTART_CMD=systemctl restart mcp-ruckus
